# === Airline Scraping Proxy (needed for El Al, Arkia, Air Haifa) ===
# Choose one: zenrows or scrapingbee
ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=

# === Aggregator APIs (backup data sources) ===
# Amadeus (free at developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Kiwi Tequila (free at tequila.kiwi.com)
KIWI_API_KEY=

# AviationStack (free at aviationstack.com/signup/free — 100 requests/month)
AVIATIONSTACK_API_KEY=

# === Sync Configuration ===
SYNC_INTERVAL_MINUTES=2
